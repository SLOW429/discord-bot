# Shared
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/slows-discord

# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match the OAuth2 redirect URI registered in the Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Express API / session
API_PORT=3001
SESSION_SECRET=replace-with-at-least-32-random-bytes
WEB_ORIGIN=http://localhost:3000
# Set true only when TLS is terminated by a trusted reverse proxy.
TRUST_PROXY=false

# Dashboard URL / deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, only for local testing with a Discord server
DISCORD_TEST_GUILD_ID=
# Enable only after enabling Message Content Intent in the Discord Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=false
