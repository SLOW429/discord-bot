# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
# --- Web ---
# رابط الداشبورد النهائي بدون / في النهاية
BASE_URL=https://dashboard.yourdomain.com
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
PORT=3000
# Lavalink v4 node pool (JSON array; use secure:true for public TLS endpoints)
LAVALINK_NODES=[{"name":"main","url":"lavalink.example.net:443","auth":"replace_with_lavalink_password","secure":true}]
# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/discordbot
# --- Streams (اختياري لكن مطلوب للميزة) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=
# --- Stream polling (optional) ---
STREAM_CHECK_INTERVAL_SECONDS=60
YOUTUBE_POLL_INTERVAL_MINUTES=15
